# ==============================================================================
# sysmqttd.toml.example
# ==============================================================================
# This is a sample configuration file for sysmqttd, a lightweight native Rust 
# system monitoring daemon optimized for single-board computers. It gathers detailed
# telemetry (CPU Temp, CPU Usage %, RAM/Disk utilization % and raw capacity values,
# system load averages, network interface bandwidth, uptime, pending system upgrades, 
# and top resource consumers) and sends it over
# MQTT to Home Assistant.
#
# To use:
# 1. Copy this file to a valid search location:
#    - Inside the local working directory as `sysmqttd.toml`
#    - Under `/etc/sysmqttd/sysmqttd.toml` (recommended for systemd services)
#
#    Example:
#    cp sysmqttd.toml.example /etc/sysmqttd/sysmqttd.toml
#
# 2. Update the host, authentication credentials, and optional GPIO pins below.
# ==============================================================================

# ------------------------------------------------------------------------------
# MQTT Broker Configuration (Required)
# ------------------------------------------------------------------------------

# Hostname or IP address of the Home Assistant MQTT Broker.
host = "192.168.1.50"

# Port number for connecting to the MQTT Broker (Default: 1883).
port = 1883

# Optional: Username for broker authentication. 
# Comment out or omit if your broker does not require authentication.
user = "mqtt_user"

# Optional: Password for broker authentication. 
# Comment out or omit if your broker does not require authentication.
# WARNING: NEVER commit this file to git/public repositories with secrets!
password = "supersecretpassword"

# Optional: Enable secure TLS broker connection (Default: false).
# If set to true, the default port changes to 8883 (if port is not explicitly configured).
# use_tls = false

# Optional: Custom/self-signed root CA certificate path for TLS.
# If use_tls is enabled and this is omitted, sysmqttd automatically falls back to 
# loading the host system's native root certificate store.
# ca_cert_path = "/etc/sysmqttd/ca.crt"

# Optional: Reconnection retry delay settings.
# sysmqttd uses a dynamic Jittered Exponential Backoff algorithm when the broker drops
# connection to avoid thundering herd conditions and journal-spamming.
#
# Initial connection retry delay in seconds before doubling on consecutive failures (Default: 2).
# reconnect_initial_delay = 2
#
# Maximum reconnection retry delay limit/ceiling in seconds (Default: 300).
# reconnect_max_delay = 300

# ------------------------------------------------------------------------------
# System & Discovery Configuration (Optional)
# ------------------------------------------------------------------------------

# Discovery prefix for Home Assistant MQTT Auto-Discovery (Default: "homeassistant").
prefix = "homeassistant"

# The network interface card to monitor for RX & TX rates (Default: "wlan0").
# Use `ip link` or `ifconfig` to find your target network interface name.
interface = "eth0"

# Enable verbose logging for detailed payloads, events, and transitions (Default: false).
verbose = false

# The temperature unit for CPU temperature monitoring: "C" (Celsius) or "F" (Fahrenheit) (Default: "F").
# temperature_unit = "F"

# Optional: The telemetry gathering and publication polling interval in seconds (Default: 60).
# Enforces a minimum bound of 1 second and a maximum of 86400 seconds (24 hours).
# telemetry_interval = 60

# Optional: Root disk space utilization threshold guard (Default: 95.0).
# When root "/" capacity reaches or exceeds this percentage, sysmqttd turns ON
# the Home Assistant "SD Card Space Alert" binary sensor (problem device class),
# and instantly silences/quiets all logging output to standard streams to prevent
# journald/syslog disk write amplification loops.
# sd_alert_threshold = 95.0

# ------------------------------------------------------------------------------
# GPIO Input Monitoring (Optional)
# ------------------------------------------------------------------------------
# Monitors physical state transitions of configured GPIO input pins (e.g., buttons, 
# door sensors) and publishes changes to Home Assistant as binary sensors.
#
# Each entry requires:
# - `pin`: The physical GPIO pin number (BCM numbering).
# - `name`: A user-friendly name displayed in Home Assistant.
# - `device_class`: Optional Home Assistant binary sensor device class.
#   Valid classes: "door", "window", "motion", "connectivity", "safety", "smoke", 
#                  "gas", "moisture", "light", "plug", "power", "problem", etc.
#
# Uncomment the block below to configure:
#
# [[gpio_inputs]]
# pin = 23
# name = "Front Door"
# device_class = "door"
#
# [[gpio_inputs]]
# pin = 18
# name = "Motion Sensor"
# device_class = "motion"

# ------------------------------------------------------------------------------
# GPIO Output Actuation Control (Optional)
# ------------------------------------------------------------------------------
# Drives physical output devices (e.g., relays, indicators) connected to whitelisted
# GPIO pins via incoming MQTT switch commands.
#
# Each entry requires:
# - `pin`: The physical GPIO pin number (BCM numbering).
# - `name`: A user-friendly name displayed in Home Assistant as a switch.
#
# Uncomment the block below to configure:
#
# [[gpio_outputs]]
# pin = 24
# name = "Relay 1"
#
# [[gpio_outputs]]
# pin = 25
# name = "Status LED"

# ------------------------------------------------------------------------------
# Systemd Service Monitoring and Control (Optional)
# ------------------------------------------------------------------------------
# Note: Whitelisted systemd services are currently configured via the 
# MONITORED_SERVICES environment variable (e.g., in /etc/default/sysmqttd)
# or using the CLI flag: `--services "nginx,docker,ssh"`.
#
# For each monitored service, sysmqttd will:
# 1. Register a binary sensor (connectivity class) indicating its running state (active/inactive).
# 2. Register a dynamic switch entity in Home Assistant, allowing you to securely
#    Start ("ON"), Stop ("OFF"), or Restart ("RESTART") the service from the dashboard.

